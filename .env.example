# S3 Bucket Configuration for Video Uploads (Optional)
# If provided, videos uploaded via API will be stored in S3 and processed from S3.
# If omitted, videos will be processed and stored locally in data_process/data/images.
AWS_S3_BUCKET_NAME=attendance-video-data
AWS_REGION=us-east-1
AWS_S3_VIDEO_PREFIX=uploaded_videos

# AWS Credentials (Optional if configured via AWS CLI ~/.aws/credentials or IAM role)
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key
